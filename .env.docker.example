# Másold be / illeszd a Laravel .env fájlba a scaffold után.
# A host értékek a docker-compose service nevek (nem localhost!).

APP_NAME=Motibro
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8092
APP_TIMEZONE=Europe/Budapest
APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu

VITE_DEV_SERVER_URL=http://localhost:5275

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=motibro
DB_USERNAME=motibro
DB_PASSWORD=motibro

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@motibro.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:8092,localhost:5275
SESSION_DOMAIN=localhost

# Motibro Auto Booker
# http = PHP cURL (Node nélkül, shared hostingon is fut) | playwright = Node script
MOTIBRO_DRIVER=http
MOTIBRO_EMAIL=
MOTIBRO_PASSWORD=
MOTIBRO_BASE_URL=https://reform-me.motibro.com
MOTIBRO_PORTAL_SITE_ID=553
MOTIBRO_WAITLIST=false
MOTIBRO_HEADLESS=true
MOTIBRO_WEEKS_AHEAD=3
MOTIBRO_NOTIFY_EMAIL=cseszneki.agi@gmail.com

PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
NODE_BINARY=node
